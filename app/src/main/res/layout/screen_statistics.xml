<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/stats_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView  style="@style/FitCounter.Line" android:text="@string/week" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/week_stats" style="@style/FitCounter.Line" />
        <TextView  style="@style/FitCounter.Line" android:layout_marginTop="20dp" android:text="@string/month" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/month_stats" style="@style/FitCounter.Line" />
    </LinearLayout>
</ScrollView>
