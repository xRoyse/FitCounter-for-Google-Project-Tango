<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/training_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <com.example.fitcounter.PreviewPane android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="240dp" android:background="@color/black">
            <TextureView android:id="@+id/camera_texture" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/preview_label"/>
            <com.example.fitcounter.SkeletonView android:id="@+id/skeleton" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </com.example.fitcounter.PreviewPane>
        <TextView android:id="@+id/camera_status" style="@style/FitCounter.Line" />
        <Button android:id="@+id/switch_camera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/switch_camera" android:visibility="gone"/>
        <Button android:id="@+id/retry_camera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/retry" android:visibility="gone"/>
        <TextView  style="@style/FitCounter.Line" android:labelFor="@id/exercise" android:text="@string/exercise_label"/>
        <Spinner android:id="@+id/exercise" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"/>
        <TextView android:id="@+id/repetitions" style="@style/FitCounter.Line" android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:id="@+id/angle" style="@style/FitCounter.Line" />
        <TextView android:id="@+id/phase" style="@style/FitCounter.Line" />
        <TextView android:id="@+id/hint" style="@style/FitCounter.Line" />
        <TextView android:id="@+id/save_message" style="@style/FitCounter.Line" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/start_workout" style="@style/FitCounter.Nav" android:text="@string/start" />
            <Button android:id="@+id/finish_workout" style="@style/FitCounter.Nav" android:text="@string/finish" />
            <Button android:id="@+id/reset_workout" style="@style/FitCounter.Nav" android:text="@string/reset" />
        </LinearLayout>
        <Button android:id="@+id/thresholds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/thresholds" />
    </LinearLayout>
</ScrollView>
