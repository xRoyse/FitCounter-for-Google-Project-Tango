<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/ui_card">
    <TextView style="@style/FitCounter.Line" android:background="@drawable/ui_warn" android:text="@string/month" android:padding="12dp" android:textSize="19sp" android:textStyle="bold" />
    <TextView android:id="@+id/month_stats" style="@style/FitCounter.Caption" android:padding="12dp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="64dp" android:paddingStart="10dp" android:paddingEnd="10dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="12dp" android:src="@drawable/ui_push" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/push_up" android:textColor="@color/ui_graphite" android:textSize="16sp" />
        <TextView android:id="@+id/month_push" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_emerald" android:textSize="36sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="64dp" android:paddingStart="10dp" android:paddingEnd="10dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="12dp" android:src="@drawable/ui_squat" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/squat" android:textColor="@color/ui_graphite" android:textSize="16sp" />
        <TextView android:id="@+id/month_squat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_emerald" android:textSize="36sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>